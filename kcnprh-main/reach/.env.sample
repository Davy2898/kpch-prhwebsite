FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Local development uses SQLite by default. Uncomment and set this for PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional public URL for links sent in notifications
# PUBLIC_URL=http://localhost:5001

# Optional server and upload settings (defaults shown)
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5001
# UPLOAD_FOLDER=
# MAX_CONTENT_LENGTH=20971520

# Optional production/infrastructure settings
# SESSION_COOKIE_SAMESITE=Lax
# REMEMBER_COOKIE_SAMESITE=Lax
# PREFERRED_URL_SCHEME=https
# RATELIMIT_STORAGE=memory://
